{"geneId":"2652","symbol":"OPN1MW","description":"opsin 1, medium wave sensitive","taxId":"9606","taxname":"Homo sapiens","type":"PROTEIN_CODING","orientation":"plus","commonName":"human","chromosomes":["X"],"nomenclatureAuthority":{"authority":"HGNC","identifier":"HGNC:4206"},"swissProtAccessions":["P04001"],"ensemblGeneIds":["ENSG00000268221"],"omimIds":["300821"],"synonyms":["CBD","GCP","GOP","CBBM","COD5","OPN1MW1"],"referenceStandards":[{"geneRange":{"accessionVersion":"NG_011606.2","range":[{"begin":"5002","end":"19267","orientation":"plus"}]},"type":"REFSEQ_GENE"}],"annotations":[{"assemblyAccession":"GCF_000001405.40","assemblyName":"GRCh38.p14","annotationName":"GCF_000001405.40-RS_2025_08","annotationReleaseDate":"2025-08-01","genomicLocations":[{"genomicAccessionVersion":"NC_000023.11","sequenceName":"X","genomicRange":{"begin":"154182596","end":"154196861","orientation":"plus"}}]},{"assemblyAccession":"GCF_009914755.1","assemblyName":"T2T-CHM13v2.0","annotationName":"GCF_009914755.1-RS_2025_08","annotationReleaseDate":"2025-08-01","genomicLocations":[{"genomicAccessionVersion":"NC_060947.1","sequenceName":"X","genomicRange":{"begin":"152456258","end":"152470523","orientation":"plus"}}]}],"transcriptCount":1,"proteinCount":1,"transcriptTypeCounts":[{"type":"PROTEIN_CODING","count":1}],"geneGroups":[{"id":"2652","method":"NCBI Ortholog"}],"summary":[{"description":"This gene encodes for a light absorbing visual pigment of the opsin gene family. The encoded protein is called green cone photopigment or medium-wavelength sensitive opsin. Opsins are G-protein coupled receptors with seven transmembrane domains, an N-terminal extracellular domain, and a C-terminal cytoplasmic domain. The long-wavelength opsin gene and multiple copies of the medium-wavelength opsin gene are tandemly arrayed on the X chromosome and frequent unequal recombination and gene conversion may occur between these sequences. X chromosomes may have fusions of the medium- and long-wavelength opsin genes or may have more than one copy of these genes. Defects in this gene are the cause of deutanopic colorblindness. [provided by RefSeq, Mar 2009]"}],"geneOntology":{"assignedBy":"GOA","molecularFunctions":[{"name":"G protein-coupled photoreceptor activity","goId":"GO:0008020","evidenceCode":"IBA","qualifier":"enables"},{"name":"G protein-coupled photoreceptor activity","goId":"GO:0008020","evidenceCode":"IDA","qualifier":"enables","reference":{"pmids":["15773913"]}},{"name":"G protein-coupled photoreceptor activity","goId":"GO:0008020","evidenceCode":"ISS","qualifier":"enables"},{"name":"G protein-coupled receptor activity","goId":"GO:0004930","evidenceCode":"IEA","qualifier":"enables"},{"name":"identical protein binding","goId":"GO:0042802","evidenceCode":"IDA","qualifier":"enables","reference":{"pmids":["28402104"]}},{"name":"photoreceptor activity","goId":"GO:0009881","evidenceCode":"IMP","qualifier":"enables","reference":{"pmids":["8185948"]}},{"name":"photoreceptor activity","goId":"GO:0009881","evidenceCode":"TAS","qualifier":"enables","reference":{"pmids":["1302020"]}}],"biologicalProcesses":[{"name":"G protein-coupled receptor signaling pathway","goId":"GO:0007186","evidenceCode":"IBA","qualifier":"involved_in"},{"name":"G protein-coupled receptor signaling pathway","goId":"GO:0007186","evidenceCode":"IEA","qualifier":"involved_in"},{"name":"G protein-coupled receptor signaling pathway","goId":"GO:0007186","evidenceCode":"TAS","qualifier":"involved_in","reference":{"pmids":["2937147"]}},{"name":"absorption of visible light","goId":"GO:0016038","evidenceCode":"IBA","qualifier":"involved_in"},{"name":"absorption of visible light","goId":"GO:0016038","evidenceCode":"IDA","qualifier":"involved_in","reference":{"pmids":["6140680"]}},{"name":"cellular response to light stimulus","goId":"GO:0071482","evidenceCode":"IBA","qualifier":"involved_in"},{"name":"phototransduction","goId":"GO:0007602","evidenceCode":"IBA","qualifier":"involved_in"},{"name":"photo